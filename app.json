{
  "expo": {
    "name": "APK Demo",
    "slug": "apk-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.apkdemo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E8F1F0",
